# simplifi-mcp configuration (all optional except credentials for `login`).
# Compatible with `op run --env-file=.env -- simplifi-mcp ...` (1Password).
# Secrets are NEVER written to the repo; the token cache is encrypted at rest.

# --- Simplifi credentials (needed only for `simplifi-mcp login`) ---
SIMPLIFI_EMAIL=
SIMPLIFI_PASSWORD=

# Quicken's web-app OAuth client secret. Deliberately NOT bundled (SA-18).
# Read it from your own browser session (DevTools -> the /oauth/token request body).
SIMPLIFI_CLIENT_SECRET=

# --- Token-cache encryption key (pick ONE; else macOS keychain auto-creates one) ---
# 32 bytes, base64 (standard alphabet):  head -c 32 /dev/urandom | base64
# SIMPLIFI_MCP_TOKEN_KEY=
# SIMPLIFI_MCP_TOKEN_KEY_FILE=/path/to/key   # file must be chmod 0600

# --- Optional overrides (defaults shown) ---
# SIMPLIFI_BASE_URL=https://services.quicken.com
# SIMPLIFI_REDIRECT_URI=https://simplifi.quicken.com/login
# SIMPLIFI_CLIENT_ID=acme_web
# SIMPLIFI_DATASET_ID=            # auto-discovered via GET /datasets if unset
# SIMPLIFI_TM_SESSION_ID=         # paste a real browser ThreatMetrix id if needed;
#                                 # otherwise one is generated ONCE and persisted
# SIMPLIFI_DATA_DIR=~/Library/Application Support/simplifi-mcp  (or $XDG_DATA_HOME)
# SIMPLIFI_HTTP_TIMEOUT_MS=30000
# SIMPLIFI_MIN_REQUEST_INTERVAL_MS=250
# SIMPLIFI_MAX_PAGES=200
# SIMPLIFI_PAGE_LIMIT=5000
# SIMPLIFI_MAX_CREDENTIAL_LOGINS_PER_24H=3

# Fall back to a (budgeted, backed-off) password login when refresh fails.
# Default false: only an explicit `simplifi-mcp login` performs a credential login.
# SIMPLIFI_AUTO_PASSWORD_LOGIN=false

# Enable the HAR-UNVERIFIED transaction create / bulk-create / delete endpoints.
# Default false. Only set to 1 AFTER verifying the wire shape with a DevTools capture.
# SIMPLIFI_ENABLE_UNVERIFIED_WRITES=false

# --- MCP server (`serve` / `serve-http`) ---
# Mutating tools (update/categorize/create/bulk-import). Default false = read-only (SA-09).
# SIMPLIFI_MCP_ALLOW_WRITES=false
# Cache freshness window and the hard floor between upstream syncs (SA-13).
# SIMPLIFI_MCP_MAX_STALE_SECS=120
# SIMPLIFI_MCP_MIN_SYNC_INTERVAL_SECS=30
# Rolling per-hour cap on mutations; bulk imports count one per row (SA-09).
# SIMPLIFI_MCP_MAX_WRITES_PER_HOUR=60

# --- HTTP transport only (feature `http`, `serve-http`) ---
# REQUIRED for serve-http; >= 32 chars:  openssl rand -base64 33
# SIMPLIFI_MCP_HTTP_TOKEN=
# Non-loopback binds are refused unless this is set (put TLS in front first):
# SIMPLIFI_MCP_HTTP_ALLOW_NONLOCAL=false
