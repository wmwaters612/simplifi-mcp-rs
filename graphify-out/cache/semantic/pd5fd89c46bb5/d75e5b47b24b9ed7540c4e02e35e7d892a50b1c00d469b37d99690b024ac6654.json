{"nodes": [{"id": "readme_simplifi_mcp", "label": "simplifi-mcp (Rust MCP server + client)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_krconv_quicken_simplifi_mcp", "label": "krconv/quicken-simplifi-mcp (upstream TypeScript project)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rmcp", "label": "MCP Rust SDK (rmcp)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_encrypted_token_cache", "label": "Encrypted-at-rest token cache", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XChaCha20-Poly1305 token cache with key in macOS Keychain/env/0600 key file so no plaintext tokens are ever stored; 0600/0700 permissions enforced at every open."}, {"id": "readme_account_lockout_protection", "label": "Account-lockout protection as defaults", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-flight auth, exponential backoff, a hard rolling-24h credential-login budget, one persisted ThreatMetrix device identity, a global pacing floor, and Retry-After honoring exist because upstream's failure mode was ~1,440 password logins/day on a stuck refresh."}, {"id": "readme_read_only_default", "label": "Read-only by default", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typed allowlisted patches instead of free-form deep merge, plus an append-only audit journal with before/after images for every mutation and a per-hour write quota, to prevent a malicious/compromised client from corrupting financial records."}, {"id": "readme_ssrf_hardened_pagination", "label": "SSRF-hardened pagination", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host allowlist, https-only, redirects disabled, cycle detection, and an error taxonomy that never leaks upstream response bodies, to defend against token exfiltration via upstream-controlled nextLink URLs."}, {"id": "readme_decimal_exact_money", "label": "Decimal-exact money end-to-end", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rust_decimal used so amounts cross the MCP boundary as strings, never floats, avoiding float-precision errors on financial data."}, {"id": "readme_write_gating_defense_in_depth", "label": "Write gating (defense in depth)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five layered controls: SIMPLIFI_MCP_ALLOW_WRITES gate, additional SIMPLIFI_ENABLE_UNVERIFIED_WRITES gate for create/bulk endpoints whose wire shape is inferred, explicit confirm:true for bulk import, a rolling per-hour write quota, and an append-only audit journal that forces read-only if it cannot be opened."}, {"id": "readme_list_transactions", "label": "list_transactions (MCP tool)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_search_transactions", "label": "search_transactions (MCP tool)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captu